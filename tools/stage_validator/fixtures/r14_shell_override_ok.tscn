[gd_scene load_steps=6 format=3 expect="none"]]

[ext_resource type="Script" path="res://scripts/chapter/chapter_shell.gd" id="1_shell"]
[ext_resource type="PackedScene" path="res://ui/game_hud.tscn" id="4_hud"]
[ext_resource type="PackedScene" path="res://ui/menus/pause_menu.tscn" id="5_pause"]
[ext_resource type="PackedScene" path="res://ui/menus/death_screen.tscn" id="6_death"]
[ext_resource type="PackedScene" path="res://characters/enemies/spar_enemy/spar_enemy.tscn" id="9_ovr"]

[node name="ChapterShell" type="Node2D"]
script = ExtResource("1_shell")
chapter_id = &"r14_probe"
playable_override = ExtResource("9_ovr")

[node name="Players" type="Node2D" parent="."]
metadata/_主角放这里 = "空场地基（5a）：主角三来源之一——把玩家档角色 .tscn 拖进本容器（须带 area2d:player 组），或设壳根 playable_override 槽（推荐正门）。相机由壳自动补挂，无需手摆。"

position = Vector2(500, 600)

limit_top = -280
limit_right = 2000
limit_bottom = 1200

[node name="HudLayer" type="CanvasLayer" parent="."]
layer = 2

[node name="GameHUD" parent="HudLayer" instance=ExtResource("4_hud")]

[node name="PauseLayer" type="Control" parent="HudLayer"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="PauseMenu" parent="HudLayer/PauseLayer" instance=ExtResource("5_pause")]
anchors_preset = 0

[node name="DeathScreen" parent="HudLayer/PauseLayer" instance=ExtResource("6_death")]
anchors_preset = 0

[node name="StageEndPanel" type="PanelContainer" parent="HudLayer"]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -140.0
offset_top = -60.0
offset_right = 140.0
offset_bottom = 60.0
grow_horizontal = 2
grow_vertical = 2

[node name="PanelBox" type="VBoxContainer" parent="HudLayer/StageEndPanel"]
layout_mode = 2

[node name="BackTitle" type="Button" parent="HudLayer/StageEndPanel/PanelBox"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
text = "返回标题"

[node name="Replay" type="Button" parent="HudLayer/StageEndPanel/PanelBox"]
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
text = "重走一遍"

[node name="Ambient" type="Node2D" parent="."]

[node name="CanvasModulate" type="CanvasModulate" parent="Ambient"]

[node name="Segments" type="Node2D" parent="."]
