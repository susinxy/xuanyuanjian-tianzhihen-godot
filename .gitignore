# Godot 4 specific ignores
.godot/
**/*.uid

# Godot exported builds
build/
export/
export_presets.cfg
*.pck
*.exe
*.x86_64
*.app
*.apk

# Imported resources (cached, re-generated by Godot)
.import/
*.import

# Syncthing conflict files
*.sync-conflict-*

# OS-specific
.DS_Store
Thumbs.db
.stfolder

# Editor files
.vscode/
.idea/
*.sublime-*

# 具体角色（由 _template 生成）不纳入版本控制：逐角色的烘焙/临时改动不进 git；
# 需提交时用 `git add -f` 强制添加。要改模板请改 _template/ 下的文件。
characters/playable/*
!characters/playable/_template/
!characters/playable/enemy/

# Run Test 生成物（角色/法术测试场景与 helper 脚本）：由插件模板随时可再生，不跟踪
test_scenes/

# Godot 编辑器原子写残留
*.tmp
