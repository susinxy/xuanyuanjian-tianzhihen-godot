[gd_resource type="AnimationNodeBlendTree" format=3]

[sub_resource type="AnimationNodeAnimation" id="AnimNode_active_right"]
animation = &"__CLASS__/active_right"

[sub_resource type="AnimationNodeAnimation" id="AnimNode_active_left"]
animation = &"__CLASS__/active_left"

[sub_resource type="AnimationNodeBlendSpace1D" id="BlendSpace_active"]
blend_point_0/node = SubResource("AnimNode_active_right")
blend_point_0/pos = 0.1
blend_point_0/name = &"0"
blend_point_1/node = SubResource("AnimNode_active_left")
blend_point_1/pos = -0.1
blend_point_1/name = &"1"

[sub_resource type="AnimationNodeStateMachineTransition" id="Transition_start_to_active"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachine" id="StateMachine_main"]
states/Start/position = Vector2(0, 0)
states/active/node = SubResource("BlendSpace_active")
states/active/position = Vector2(300, 0)
transitions = ["Start", "active", SubResource("Transition_start_to_active")]

[sub_resource type="AnimationNodeTimeScale" id="TimeScale_main"]

[resource]
nodes/output/position = Vector2(600, 0)
nodes/state_machine/node = SubResource("StateMachine_main")
nodes/state_machine/position = Vector2(200, 0)
nodes/time_scale/node = SubResource("TimeScale_main")
nodes/time_scale/position = Vector2(400, 0)
node_connections = [&"output", 0, &"time_scale", &"time_scale", 0, &"state_machine"]
