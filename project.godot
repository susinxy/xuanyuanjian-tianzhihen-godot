[layer_names]

2d_physics/layer_1="players"
2d_physics/layer_2="obstacles"
2d_physics/layer_3="screen_limits"
2d_physics/layer_4="ceiling_limits"
2d_physics/layer_5="enemies"
2d_physics/layer_8="world_hit_boxes"
2d_physics/layer_9="player_hit_boxes"
2d_physics/layer_10="enemy_hit_boxes"
2d_physics/layer_11="player_grab_boxes"
2d_physics/layer_12="enemy_grab_boxes"
2d_physics/layer_13="player_hurt_boxes"
2d_physics/layer_14="enemy_hurt_boxes"
2d_physics/layer_15="height_ground"
2d_physics/layer_16="height_low_air"
2d_physics/layer_17="height_mid_air"
2d_physics/layer_18="height_high_air"
2d_physics/layer_19="height_very_high"

[physics]

2d/default_gravity=3000.0

[quiver]

beat_em_up/gameplay/default_hit_lane_size=60
beat_em_up/debug/logging_enabled=true
beat_em_up/gameplay/fall_gravity_modifier=2.5
beat_em_up/debug/disable_player_detector_on_editor=false
